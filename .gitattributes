# Normalize all text to LF in the repository. Without this, line endings
# depend on each machine's core.autocrlf, which makes clean files look
# modified. Checkouts on Windows still get CRLF where autocrlf asks for it.
* text=auto

# Generated by scripts/build.py; keep diffs readable but expect churn.
site/data/*.json text

# Raw Music League exports, never hand-edited.
data/season*/*.csv text
