# Copy this to .env (git-ignored) and fill in both values.
# Both come from the Supabase dashboard: Project Settings > API Keys / Data API.
# The SECRET key bypasses every access rule: keep it only in .env, never in
# site/config.js, never in a commit, never pasted into chat.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Round playlists (scripts/round_playlists.py; README, Submissions on the
# site, has the setup). The two *_REFRESH_TOKEN lines are written for you by
# python scripts/connect_accounts.py spotify|youtube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
